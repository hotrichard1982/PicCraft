{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "piccarft",
  "version": "0.1.0",
  "identifier": "com.piccarft.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5500",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
  },
  "app": {
    "windows": [
      {
        "title": "图轻剪 PicCraft",
        "width": 1120,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; connect-src 'self' asset: http://asset.localhost https://asset.localhost ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
